{{- $index := slice -}}
{{- range where .Site.RegularPages "Type" "in" .Site.Params.mainSections -}}
  
  {{- $tagsList := delimit (.Params.tags | default slice) ", " -}}
  {{- $keywordsList := delimit (.Params.keywords | default slice) ", " -}}
  {{- $fullContents := printf "%s | Tags: %s | Keywords: %s" .Plain $tagsList $keywordsList -}}
  
  {{- $page := dict "title" .Title "contents" $fullContents "permalink" .Permalink "summary" (.Summary | plainify | htmlUnescape) "date" (.Date.Format "2006-01-02") "tags" (.Params.tags | default slice) -}}
  {{- $index = $index | append $page -}}
{{- end -}}
{{- /* Τα queries της Βιβλιοθήκης KQL (data/kql.yaml), ώστε να βγαίνουν και αυτά στην αναζήτηση. Τα draft δεν μπαίνουν. */ -}}
{{- with site.GetPage "/kql" -}}
  {{- $kqlPage := . -}}
  {{- $d := site.Data.kql -}}
  {{- range $d.queries -}}
    {{- if not .draft -}}
      {{- $codes := slice -}}
      {{- range $k, $v := .map }}{{ $codes = $codes | append $v }}{{ end -}}
      {{- $when := .tested | default .verified | default $d.updated -}}
      {{- $contents := printf "%s %s | %s | %s | %s | %s" .summary .why .product .table (delimit $codes " ") .query -}}
      {{- $page := dict "title" (printf "KQL: %s" .title) "contents" $contents "permalink" (printf "%s#%s" $kqlPage.Permalink .id) "summary" .summary "date" ((time $when).Format "2006-01-02") "tags" (slice "KQL" .product) "type" "kql" -}}
      {{- $index = $index | append $page -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Οι οδηγοί συμμόρφωσης (ΚΥΑ 1689/2025, NIS2, ISO 27001, GDPR): ένα αποτέλεσμα ανά άρθρο ή ομάδα controls
       και ένα ανά απαίτηση. Το "source" λέει από ποιον οδηγό είναι, ώστε το «Άρθρο 20» να ξεχωρίζει ανάμεσα σε ΚΥΑ, NIS2 και GDPR. */ -}}
{{- /* "url" εδώ είναι η διαδρομή του αρχείου στο content/ (π.χ. content/nis2.md είναι η σελίδα /kya-1689-2025/). */ -}}
{{- $guides := slice
    (dict "url" "/nis2"          "key" "nis2"          "source" "ΚΥΑ 1689/2025")
    (dict "url" "/nis2-directive" "key" "nis2directive" "source" "NIS2")
    (dict "url" "/iso27001"      "key" "iso27001"      "source" "ISO 27001")
    (dict "url" "/gdpr"          "key" "gdpr"          "source" "GDPR") -}}
{{- range $guides -}}
  {{- $g := . -}}
  {{- with site.GetPage $g.url -}}
    {{- $gp := . -}}
    {{- $d := index site.Data $g.key -}}
    {{- $date := (time $d.updated).Format "2006-01-02" -}}
    {{- range $d.articles -}}
      {{- $a := . -}}
      {{- $label := .label | default (printf "Άρθρο %v" .number) -}}
      {{- $all := slice -}}
      {{- range .requirements }}{{ $all = $all | append (printf "%s %s" .code .requirement) }}{{ end -}}
      {{- $index = $index | append (dict "title" (printf "%s: %s" $label .title) "contents" (delimit $all " | ") "permalink" (printf "%s#arthro-%v" $gp.Permalink .number) "summary" (printf "%s, %s: %d %s" $g.source $label (len .requirements) (cond (eq (len .requirements) 1) ($d.source.item | default "απαίτηση") ($d.source.items | default "απαιτήσεις"))) "date" $date "type" "guide" "source" $g.source) -}}
      {{- range .requirements -}}
        {{- $c := printf "%s %s %s %s %s" (.desc | default "") .control .evidence (.license | default "") (.comment | default "") -}}
        {{- $index = $index | append (dict "title" (printf "%s %s" .code (.requirement | truncate 110)) "contents" $c "permalink" (printf "%s#%s" $gp.Permalink (replace .code "." "-")) "summary" (printf "%s, %s: %s" $g.source $label (.requirement | truncate 160)) "date" $date "type" "guide" "source" $g.source) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
